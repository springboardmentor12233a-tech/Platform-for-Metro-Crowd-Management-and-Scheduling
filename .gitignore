database/dumps/

# IMPORTANT:
# Do NOT ignore your actual SQL schema/migration files
# if they are meant to be committed.


# =========================================================
# DATASETS
# =========================================================

# Ignore large raw datasets
datasets/raw/

# Ignore generated/processed datasets if they are large
datasets/processed/

# Dataset caches
datasets/cache/

# Keep dataset documentation
!datasets/README.md


